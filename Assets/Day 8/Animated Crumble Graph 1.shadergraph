{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "9cd25242b0934872a36acf69e3a1ea7f",
    "m_Title": "Normal Rotation",
    "m_Content": "Because the rotation is uniform across teh surface (no part is rotated mor than the other, there \nis no interpolation needed, we can just rotate the normal by the same amount as the object and get the new normal vector and update it in object space\n\nnote that the rotation MUST MATCH the object rotation",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
